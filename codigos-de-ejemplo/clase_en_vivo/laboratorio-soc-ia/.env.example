# Copiá este archivo a .env y ajustá lo que necesites.

# Backend del LLM para la investigación:
#   mock   -> determinístico y RÁPIDO 
#   ollama -> modelo local llama3.2 (si tarda >45s, cae a mock solo)
#   openai -> API compatible OpenAI (requiere SOC_OPENAI_API_KEY)
SOC_LLM_BACKEND=mock

# Si usás ollama:
SOC_OLLAMA_MODEL=llama3.2

# Si usás openai (o compatible):
SOC_OPENAI_API_KEY=
SOC_OPENAI_MODEL=gpt-4o-mini

# ¿El atacante ataca solo al arrancar? (true/false)
AUTO_ATTACK=false

# URL pública del dashboard (links en emails)
SOC_DASHBOARD_URL=http://localhost:9000

# ── Email real (opcional) ────────────────────────────────────────────
# Vacío = solo guarda .eml en /data/state/mailbox (modo demo).
# Gmail: activá 2FA y creá una "App password" en
#   https://myaccount.google.com/apppasswords
# SOC_SMTP_HOST=smtp.gmail.com
# SOC_SMTP_PORT=587
# SOC_SMTP_STARTTLS=true
# SOC_SMTP_USER=tu.mail@gmail.com
# SOC_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SOC_EMAIL_FROM=tu.mail@gmail.com
# SOC_EMAIL_TO=tu.mail@gmail.com
